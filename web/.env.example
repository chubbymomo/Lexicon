# Postgres connection string.
DATABASE_URL="postgresql://lexicon:lexicon@localhost:5432/lexicon"

# Shared secret everyone enters once when creating their account.
LEXICON_INVITE_CODE="change-me"

# Optional cap on the number of accounts. Leave unset for no limit.
# LEXICON_MAX_USERS=4

# IANA time zone for streak days and weekly challenges. Defaults to UTC.
# LEXICON_TIMEZONE="America/New_York"

# Claude API key for the AI tutor and word-entry drafting. Without it the app
# still runs: words must be entered by hand and sentences cannot be evaluated.
ANTHROPIC_API_KEY=""
