# Settings for `docker compose`. Copy to `.env` and fill in.

# Password for the bundled Postgres database. Use letters and digits only
# (it is placed inside a connection URL). Choose it before the first start;
# changing it later does not change the password of an existing database.
POSTGRES_PASSWORD=

# Shared secret everyone enters once when creating their account.
LEXICON_INVITE_CODE=

# Claude API key for the AI tutor. Without it the app still runs, but word
# entries must be written by hand and sentences cannot be evaluated.
ANTHROPIC_API_KEY=

# IANA time zone for streak days and weekly challenges, e.g. America/New_York.
LEXICON_TIMEZONE=UTC

# Port the app is published on.
LEXICON_PORT=3000

# Optional cap on the number of accounts. Leave empty for no limit.
LEXICON_MAX_USERS=

# Leave empty: cookies are marked Secure when the request arrives over HTTPS
# (directly or via a reverse proxy that sends X-Forwarded-Proto). Set to
# "true" if your proxy terminates HTTPS but does not send that header.
LEXICON_SECURE_COOKIES=
